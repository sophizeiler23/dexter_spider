# Normalize text files while preserving platform-specific scripts.
* text=auto
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.json text
*.asmdef text
*.asmref text
*.inputactions text
*.unity text
*.prefab text
*.asset text
*.meta text
*.mat text
*.controller text
*.anim text
*.uxml text
*.uss text
*.sh text eol=lf
*.bat text eol=crlf

# Large binary Unity assets managed by Git LFS.
*.psd filter=lfs diff=lfs merge=lfs -text
